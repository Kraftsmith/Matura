---
import Base from '../layouts/Base.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import Pricing from '../components/Pricing.astro';
import LeadForm from '../components/LeadForm';
import Faq from '../components/Faq.astro';
import { pricing } from '../../site.config';
import { breadcrumbList, faqPage, softwareApplication } from '../lib/seo';

const crumbs = [{ name: 'Cennik', href: '/cennik' }];
const paid = pricing.monthly !== null || pricing.untilMatura !== null;
const faq = [
  { q: 'Kiedy wystartuje pełny dostęp?', a: 'Przed szczytem przygotowań do matury. Zostaw adres poniżej, a dostaniesz jedną wiadomość w dniu startu.' },
  { q: 'Czy darmowe konto wygasa?', a: 'Nie. To, co jest za darmo, zostaje za darmo: otwarte tematy, fiszki i zapis postępu.' },
  { q: 'Czy będzie można zrezygnować?', a: 'Tak, w każdej chwili, bez pytań. Szczegóły w regulaminie, gdy ogłosimy ceny.' },
  { q: 'Czy jest faktura?', a: 'Tak, ceny będą zawierały VAT, faktura do pobrania z profilu.' },
];
---

<Base title="Cennik" description="Co jest za darmo, co w pełnym dostępie i ile to kosztuje. Bez zobowiązań." path="/cennik" jsonLd={[breadcrumbList(crumbs), softwareApplication(true), faqPage(faq)]}>
  <div class="wrap py-8">
    <Breadcrumbs crumbs={crumbs} />
    <h1 class="display mt-4">Cennik</h1>
    <p class="lead mt-3 max-w-3xl">Jeden temat bez logowania, więcej za darmo z kontem, wszystko w pełnym dostępie. {paid ? 'Ceny zawierają VAT. Możesz zrezygnować w każdej chwili.' : 'Ceny pełnego dostępu ogłosimy wkrótce.'}</p>
    <div class="mt-8"><Pricing full /></div>

    {!paid && (
      <section id="lista" class="mt-12 grid items-start gap-8 lg:grid-cols-2">
        <div>
          <h2 class="section-title">Powiadom mnie o starcie</h2>
          <p class="mt-3 text-ink-2">Jedna wiadomość w dniu startu pełnego dostępu, z ceną i tym, co dokładnie wchodzi. Pierwsze konta dostaną ofertę wcześniejszego dostępu.</p>
        </div>
        <LeadForm client:visible source="pricing" defaultRole="parent" />
      </section>
    )}
  </div>
  <Faq items={faq} title="Pytania o cennik" />
</Base>
