---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import { article, breadcrumbList } from '../../lib/seo';

export const getStaticPaths = async () => {
  const posts = await getCollection('blog', ({ data }) => !data.draft);
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
};

const { post } = Astro.props;
const { Content, headings } = await render(post);
const all = (await getCollection('blog', ({ data }) => !data.draft)).filter((p) => p.id !== post.id);
const related = all
  .map((p) => ({ p, score: p.data.tags.filter((t) => post.data.tags.includes(t)).length }))
  .sort((a, b) => b.score - a.score || b.p.data.date.getTime() - a.p.data.date.getTime())
  .slice(0, 3)
  .map(({ p }) => p);
const path = `/blog/${post.id}`;
const crumbs = [{ name: 'Blog', href: '/blog' }, { name: post.data.title, href: path }];
const iso = (d: Date) => d.toISOString().slice(0, 10);
const formatDate = (d: Date) => d.toLocaleDateString('pl-PL', { day: 'numeric', month: 'long', year: 'numeric' });
const toc = headings.filter((h) => h.depth === 2);
---

<Base
  title={post.data.title}
  description={post.data.description}
  path={path}
  jsonLd={[breadcrumbList(crumbs), article({ title: post.data.title, description: post.data.description, url: path, datePublished: iso(post.data.date), dateModified: iso(post.data.updated ?? post.data.date), author: post.data.author })]}
>
  <article class="wrap max-w-3xl py-8">
    <Breadcrumbs crumbs={[{ name: 'Blog', href: '/blog' }, { name: 'Wpis', href: path }]} />
    <h1 class="display mt-4">{post.data.title}</h1>
    <p class="mt-3 text-sm text-ink-3">{formatDate(post.data.date)} · {post.data.author}{post.data.updated && <> · aktualizacja {formatDate(post.data.updated)}</>}</p>
    {toc.length >= 3 && (
      <nav class="card mt-6 p-4 text-sm" aria-label="Spis treści">
        <p class="font-bold">W tym tekście</p>
        <ol class="mt-2 list-decimal pl-5 text-ink-2">
          {toc.map((h) => <li class="py-0.5"><a href={`#${h.slug}`} class="inline-block py-1 underline underline-offset-2 decoration-line hover:text-primary hover:decoration-primary">{h.text}</a></li>)}
        </ol>
      </nav>
    )}
    <div class="prose-site mt-6">
      <Content />
    </div>
    {post.data.practice && (
      <aside class="card mt-10 flex flex-wrap items-center justify-between gap-4 border border-primary/30 p-5">
        <p class="font-bold">Ćwicz to u nas</p>
        <a href={post.data.practice.href} class="rounded-lg bg-primary px-5 py-2.5 font-bold text-white hover:bg-primary-hover">{post.data.practice.label}</a>
      </aside>
    )}
    <aside class="mt-8 flex gap-4 rounded-2xl bg-hero p-5 text-sm text-ink-2">
      <span class="inline-flex h-12 w-12 shrink-0 items-center justify-center rounded-full bg-primary text-lg font-bold text-white" aria-hidden="true">M</span>
      <p><strong class="text-ink">{post.data.author}.</strong> Metodyk języka angielskiego, który widzi język jako system i zna egzamin od środka. Materiały powstają na podstawie Informatora CKE i arkuszy z poprzednich lat. <a href="/o-nas" class="text-primary underline underline-offset-2">Więcej o nas</a></p>
    </aside>
    {related.length > 0 && (
      <section class="mt-10">
        <h2 class="text-xl font-bold">Czytaj dalej</h2>
        <ul class="mt-3 grid gap-3 sm:grid-cols-3">
          {related.map((p) => (
            <li class="card p-4"><a href={`/blog/${p.id}`} class="font-semibold hover:text-primary">{p.data.title}</a></li>
          ))}
        </ul>
      </section>
    )}
  </article>
</Base>
