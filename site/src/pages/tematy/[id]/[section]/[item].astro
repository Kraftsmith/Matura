---
import Topic from '../../../../layouts/Topic.astro';
import AccessWall from '../../../../components/AccessWall.astro';
import VocabularyIsland from '../../../../islands/VocabularyIsland';
import LanguageUseIsland from '../../../../islands/LanguageUseIsland';
import GrammarIsland from '../../../../islands/GrammarIsland';
import { openModules } from '../../../../../site.config';
import { EXERCISE_TYPE_LABEL, accessOf, allModules, appHash, exerciseItemCount, exercisesOf, paragraphHtml, stripMarks, textsOf, topicPath, vocabularyExercisesByText, type SiteSection } from '../../../../lib/content';
import type { GrammarRule, LanguageUseExercise, VocabularyText } from '@app/types';

type ItemKind = 'text' | 'exercise' | 'rule' | 'test';
interface Props {
  moduleId: string;
  section: SiteSection;
  item: string;
  kind: ItemKind;
}

export const getStaticPaths = () =>
  allModules.flatMap((m) => [
    ...textsOf(m.id).map((t) => ({ params: { id: m.id, section: 'slownictwo', item: t.id }, props: { moduleId: m.id, section: 'slownictwo', item: t.id, kind: 'text' } })),
    ...exercisesOf(m.id).map((e) => ({ params: { id: m.id, section: 'srodki', item: e.id }, props: { moduleId: m.id, section: 'srodki', item: e.id, kind: 'exercise' } })),
    ...m.grammarRules.map((r) => ({ params: { id: m.id, section: 'gramatyka', item: r.id }, props: { moduleId: m.id, section: 'gramatyka', item: r.id, kind: 'rule' } })),
    { params: { id: m.id, section: 'gramatyka', item: 'test' }, props: { moduleId: m.id, section: 'gramatyka', item: 'test', kind: 'test' } },
  ]);

const { moduleId, section, item, kind } = Astro.props as Props;
const m = allModules.find((x) => x.id === moduleId)!;
const open = accessOf(moduleId) === 'open';
const allowed = [...openModules];
const next = appHash(moduleId, section, item);

let title = '';
let description = '';
let itemName = '';
let text: VocabularyText | undefined;
let exercise: LanguageUseExercise | undefined;
let exerciseIndex = 0;
let rule: GrammarRule | undefined;

if (kind === 'text') {
  text = textsOf(moduleId).find((t) => t.id === item)!;
  itemName = text.title;
  title = `${text.title}: tekst po angielsku z ćwiczeniem (${m.titlePl})`;
  description = `Tekst „${text.title}” z tematu „${m.titlePl}” (${text.subtopic}): ${text.glossary.length} kluczowych słów z definicjami i ćwiczenie na luki. Słownictwo maturalne w kontekście.`;
} else if (kind === 'exercise') {
  const list = exercisesOf(moduleId);
  exerciseIndex = list.findIndex((e) => e.id === item);
  exercise = list[exerciseIndex]!;
  itemName = `Ćwiczenie ${exerciseIndex + 1}`;
  title = `${EXERCISE_TYPE_LABEL[exercise.type]}: ${exercise.functionLabel} (${m.titlePl}, środki językowe)`;
  description = `${exercise.instruction} Ćwiczenie ${exerciseIndex + 1} z tematu „${m.titlePl}”: ${exerciseItemCount(exercise)} punktów, ${exercise.level === 'P' ? 'poziom podstawowy' : 'poziom rozszerzony'}, wyjaśnienia po sprawdzeniu.`;
} else if (kind === 'rule') {
  rule = m.grammarRules.find((r) => r.id === item)!;
  itemName = rule.title;
  title = `${rule.title}: reguła z przykładami na maturę z angielskiego`;
  description = `${rule.ruleSummary.slice(0, 120)} Przykłady z tłumaczeniem i pułapka maturalna. Gramatyka tematu „${m.titlePl}”.`;
} else {
  itemName = 'Test';
  title = `${m.titlePl}: test gramatyczny, ${m.testQuestions.length} zadań jak w arkuszu`;
  description = `${m.testQuestions.length} zadań z tematu „${m.titlePl}”: ${m.grammarSummary} Wynik od razu, wyjaśnienie każdego zadania.`;
}

const gap = text ? vocabularyExercisesByText[text.id] : undefined;
---

<Topic moduleId={moduleId} section={section} item={item} itemName={itemName} title={title} description={description} canonicalPath={kind === 'test' ? topicPath(moduleId, 'gramatyka') : undefined}>
  {kind === 'text' && text && (open ? (
    <VocabularyIsland client:load moduleId={moduleId} textId={text.id} allowedModules={allowed} />
  ) : (
    <div class="paywall-teaser card overflow-hidden">
      <img src={text.image.src} alt={text.image.alt} width="1200" height="800" class="aspect-[3/2] w-full object-cover" />
      <div class="p-6">
        <p class="text-xs font-bold uppercase text-ink-3">{text.subtopic} · {text.level === 'P' ? 'poziom podstawowy' : 'poziom rozszerzony'}</p>
        <h2 class="text-2xl font-bold">{text.title}</h2>
        <div class="prose-site mt-3">
          <p set:html={paragraphHtml(text.paragraphs[0] ?? '')} />
        </div>
        {text.paragraphs.length > 1 && <p class="text-sm text-ink-3">…dalsze {text.paragraphs.length - 1} {text.paragraphs.length - 1 === 1 ? 'akapit' : 'akapity'} w pełnym dostępie.</p>}
        <h3 class="mt-5 font-bold">Słowa z tego tekstu ({text.glossary.length})</h3>
        <ul class="mt-2 flex flex-wrap gap-1.5">
          {text.glossary.map((g) => <li class="rounded-full bg-chip px-2.5 py-0.5 text-sm">{g.term}</li>)}
        </ul>
        {gap && <p class="mt-4 text-sm text-ink-3">Ćwiczenie: {gap.items.length} zdań z luką na słowa z tekstu.</p>}
      </div>
    </div>
  ))}

  {kind === 'exercise' && exercise && (open ? (
    <LanguageUseIsland client:load moduleId={moduleId} exerciseId={exercise.id} allowedModules={allowed} />
  ) : (
    <div class="paywall-teaser card p-6">
      <p class="text-xs font-bold uppercase text-ink-3">Ćwiczenie {exerciseIndex + 1} · {EXERCISE_TYPE_LABEL[exercise.type]} · {exercise.functionLabel} · {exercise.level}</p>
      <h2 class="text-xl font-bold">{exercise.instruction}</h2>
      {exercise.tip && <p class="mt-2 rounded-lg bg-warning-tint px-3 py-2 text-sm text-warning">{exercise.tip}</p>}
      <div class="mt-4 text-ink-2">
        {exercise.type === 'matching' && <p>1. {exercise.prompts[0]?.text}</p>}
        {exercise.type === 'word-bank' && <p>1. {exercise.items[0]?.sentence}</p>}
        {exercise.type === 'mini-dialogue' && exercise.items[0]?.lines.map((l) => <p><span class="font-bold">{l.speaker}:</span> {l.text ?? '…'}{l.after ? ` ${l.after}` : ''}</p>)}
      </div>
      <p class="mt-3 text-sm text-ink-3">…i jeszcze {exerciseItemCount(exercise) - 1} {exerciseItemCount(exercise) - 1 === 1 ? 'punkt' : exerciseItemCount(exercise) - 1 < 5 ? 'punkty' : 'punktów'} ze sprawdzaniem i wyjaśnieniami w pełnym dostępie.</p>
    </div>
  ))}

  {kind === 'rule' && rule && (
    <div class:list={['card p-6', !open && 'paywall-teaser']}>
      <p class="text-xs font-bold uppercase text-ink-3">Reguła · {rule.level === 'P' ? 'poziom podstawowy' : rule.level === 'R' ? 'poziom rozszerzony' : 'oba poziomy'}</p>
      <h2 class="text-2xl font-bold">{rule.title}</h2>
      <p class="mt-3 text-ink-2">{rule.ruleSummary}</p>
      {open && rule.formula && <p class="mt-3 rounded-lg bg-hero px-4 py-2 font-mono text-sm text-primary">{rule.formula}</p>}
      <h3 class="mt-5 font-bold">Przykłady</h3>
      <ul class="mt-2 space-y-2">
        {(open ? rule.examples : rule.examples.slice(0, 1)).map((ex) => (
          <li class="rounded-lg border border-line p-3">
            <p class="font-semibold text-ink">{ex.english}</p>
            <p class="text-sm text-ink-2">{ex.polish}</p>
            {ex.note && <p class="mt-1 text-xs text-ink-3">{ex.note}</p>}
          </li>
        ))}
      </ul>
      {open && rule.maturaTrap && (
        <aside class="mt-4 rounded-lg bg-warning-tint p-4 text-sm text-warning">
          <strong>Pułapka maturalna:</strong> {rule.maturaTrap}
        </aside>
      )}
      {!open && <p class="mt-3 text-sm text-ink-3">…{rule.examples.length - 1} {rule.examples.length - 1 === 1 ? 'kolejny przykład' : 'kolejnych przykładów'}, wzór i pułapka maturalna w pełnym dostępie.</p>}
      <p class="mt-5"><a href={topicPath(moduleId, 'gramatyka', 'test')} class="font-semibold text-primary hover:underline">Sprawdź się w teście tematu →</a></p>
    </div>
  )}

  {kind === 'test' && (open ? (
    <GrammarIsland client:load moduleId={moduleId} focusId="test" allowedModules={allowed} />
  ) : (
    <div class="paywall-teaser card p-6">
      <h2 class="text-xl font-bold">Test: {m.titlePl}</h2>
      <p class="mt-2 text-ink-2">{m.testQuestions.length} zadań. Typy: {[...new Set(m.testQuestions.map((q) => q.type))].map((t) => ({ 'multiple-choice': 'wybór wielokrotny', 'word-formation': 'słowotwórstwo', 'key-word-transformation': 'transformacje ze słowem kluczem', translation: 'tłumaczenie fragmentów' })[t]).join(', ')}.</p>
      <p class="mt-2 text-ink-2">Sprawdzane reguły: {m.grammarRules.map((r) => r.title).join('; ')}.</p>
      <p class="mt-3 text-sm text-ink-3">Po sprawdzeniu każde zadanie ma wyjaśnienie i odsyłacz do reguły.</p>
    </div>
  ))}

  <AccessWall moduleId={moduleId} next={next} />
</Topic>
