---
/** "Do matury 2027: N dni" from site.config; recomputed in the browser so a cached page stays right. */
import { matura } from '../../site.config';

const daysLeft = (iso: string) => Math.ceil((new Date(`${iso}T00:00:00`).getTime() - Date.now()) / 86_400_000);
const days = matura.dateConfirmed ? daysLeft(matura.writtenDate) : undefined;
const text = !matura.dateConfirmed
  ? `Matura ${matura.year}: ${matura.month}`
  : days !== undefined && days >= 0
    ? `Do matury ${matura.year}: ${days} dni`
    : `Matura ${matura.year + 1}: zaczynamy od nowa`;
---

<a
  href="/matura-z-angielskiego/terminy"
  class="inline-flex items-center gap-2 rounded-full bg-primary-tint px-4 py-1.5 text-sm font-bold text-primary-hover hover:bg-primary/15"
  data-countdown
  data-date={matura.dateConfirmed ? matura.writtenDate : ''}
  data-year={matura.year}
>
  <span class="h-2 w-2 rounded-full bg-primary" aria-hidden="true"></span>
  <span data-countdown-text>{text}</span>
</a>

<script>
  for (const el of document.querySelectorAll<HTMLElement>('[data-countdown]')) {
    const date = el.dataset.date;
    const year = el.dataset.year;
    const target = el.querySelector('[data-countdown-text]');
    if (!date || !target) continue;
    const days = Math.ceil((new Date(`${date}T00:00:00`).getTime() - Date.now()) / 86_400_000);
    target.textContent = days >= 0 ? `Do matury ${year}: ${days} dni` : `Matura ${Number(year) + 1}: zaczynamy od nowa`;
  }
</script>
