---
import { SITE_NAME, social } from '../../site.config';

const year = new Date().getFullYear();
const columns = [
  { title: 'Produkt', links: [['/tematy', 'Tematy'], ['/matura-z-angielskiego', 'Matura z angielskiego'], ['/cennik', 'Cennik'], ['/blog', 'Blog']] },
  { title: 'Dla kogo', links: [['/', 'Dla uczniów'], ['/dla-rodzicow', 'Dla rodziców'], ['/dla-nauczycieli', 'Dla nauczycieli']] },
  { title: 'Firma', links: [['/o-nas', 'O nas'], ['/kontakt', 'Kontakt'], ['/regulamin', 'Regulamin'], ['/polityka-prywatnosci', 'Polityka prywatności']] },
];
const follow = [
  ['TikTok', social.tiktok],
  ['Instagram', social.instagram],
  ['YouTube', social.youtube],
].filter(([, href]) => href);
---

<footer class="mt-16 bg-side text-side-text">
  <div class="wrap grid gap-10 py-12 sm:grid-cols-2 lg:grid-cols-4">
    {columns.map((col) => (
      <div>
        <h2 class="mb-3 text-sm font-bold uppercase tracking-wide text-side-muted">{col.title}</h2>
        <ul class="space-y-2">
          {col.links.map(([href, label]) => (
            <li><a href={href} class="text-side-text hover:underline">{label}</a></li>
          ))}
        </ul>
      </div>
    ))}
    <div>
      <h2 class="mb-3 text-sm font-bold uppercase tracking-wide text-side-muted">Obserwuj</h2>
      {follow.length > 0 ? (
        <ul class="space-y-2">
          {follow.map(([label, href]) => (
            <li><a href={href} rel="noopener" target="_blank" class="hover:underline">{label}</a></li>
          ))}
        </ul>
      ) : (
        <p class="text-sm text-side-muted">Konta w mediach społecznościowych wkrótce.</p>
      )}
    </div>
  </div>
  <div class="border-t border-side-line">
    <div class="wrap py-6 text-sm text-side-muted">
      <p>© {year} {SITE_NAME}. Materiały opracowane na podstawie Informatora CKE (Formuła 2023). Nie jesteśmy powiązani z Centralną Komisją Egzaminacyjną.</p>
    </div>
  </div>
</footer>
